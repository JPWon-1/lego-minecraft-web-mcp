{
  "name": "blockgame-mcp",
  "version": "0.1.0",
  "description": "차곡차곡 — AI block designer with auto-generated LEGO assembly instructions. MCP server: speak, AI builds, get step-by-step manual + LDraw export.",
  "keywords": [
    "lego",
    "minecraft",
    "mcp",
    "claude",
    "ai",
    "block-designer",
    "ldraw",
    "react-three-fiber",
    "three-js",
    "websocket"
  ],
  "homepage": "https://github.com/JPWon-1/lego-minecraft-web-mcp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/JPWon-1/lego-minecraft-web-mcp.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/JPWon-1/lego-minecraft-web-mcp/issues"
  },
  "license": "MIT",
  "author": "JPWon-1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "blockgame": "dist/cli.js",
    "blockgame-mcp": "dist/mcp-cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/postbuild.mjs",
    "dev": "tsx src/cli.ts --dev",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^4.19.0",
    "open": "^10.1.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@blockgame/shared": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.28.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.21",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
